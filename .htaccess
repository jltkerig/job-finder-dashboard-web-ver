# Job Finder (web). Every address goes to app.php, except the stylesheet, scripts and pictures in static/ and assets/.
Options -Indexes
DirectoryIndex app.php

<FilesMatch "^(config\.php|config\.sample\.php|cron\.php|.*\.ps1|.*\.md|\.gitignore)$">
  Require all denied
</FilesMatch>

RewriteEngine On
# Some hosts drop the Authorization header before PHP sees it; the Résumé Builder connector needs it.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^(?:static|assets)/ - [L]
RewriteRule ^ app.php [L,QSA]
